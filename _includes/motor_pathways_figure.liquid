{% comment %}
  How motor pathways develop, and how TMS reveals them (used on _projects/2_fnirs_tms_cp.md).
  Uses the DEMR Lab's corticospinal tract development diagram (assets/img/research/cst-development.png, from the lab
  website) as the base image. Tabs pan between its three panels; TMS buttons send a pulse along the tracts and nerves
  drawn in the image (traced coordinates below, in image pixels) and the connected hands light up with an MEP.
{% endcomment %}
<figure class="lab-figure lab-figure-live cy-figure pw-figure" id="pw-figure">
  <div class="pw-tabs" role="tablist" aria-label="Stage of development">
    <button type="button" role="tab" data-stage="A">A. Immature</button>
    <button type="button" role="tab" data-stage="B">B. Typical development</button>
    <button type="button" role="tab" data-stage="C">C. Prenatal injury</button>
  </div>
  <svg class="pw-svg" viewBox="0 0 800 830" role="img" aria-labelledby="pw-title">
    <title id="pw-title">
      Diagram of corticospinal (motor) tracts from the two brain hemispheres, crossing below the brain, through the spinal
      cord, and out along nerves to the hands, in immature, typically developed and prenatally injured brains.
    </title>
    <image href="{{ '/assets/img/research/cst-development.png' | relative_url }}" x="0" y="0" width="2400" height="972"></image>
  </svg>
  <p class="pw-desc" aria-live="polite"></p>
  <div class="pw-tms">
    <span class="fn-label">TMS</span>
    <button type="button" class="cy-hold pw-fire" data-side="L" aria-label="Stimulate left hemisphere">Left hemisphere</button>
    <button type="button" class="cy-hold pw-fire" data-side="R" aria-label="Stimulate right hemisphere">Right hemisphere</button>
  </div>
  <p class="pw-result" aria-live="polite"></p>
  <div class="pw-legend" aria-hidden="true">
    <span><i class="pw-key pw-key-immature"></i>Immature motor tracts</span>
    <span><i class="pw-key pw-key-mature"></i>Mature motor tracts</span>
    <span><i class="pw-key pw-key-atypical"></i>Atypical ipsilateral motor tracts</span>
  </div>
  <figcaption>
    <b>Fig. 2a.</b> How the brain's motor pathways to the hands develop, and what a TMS pulse reveals about them.
    Diagram: DEMR Lab, Boston University.
  </figcaption>
</figure>

<script>
  (function () {
    var fig = document.getElementById("pw-figure");
    if (!fig) return;
    var svg = fig.querySelector(".pw-svg");
    var desc = fig.querySelector(".pw-desc");
    var result = fig.querySelector(".pw-result");
    var tabs = Array.prototype.slice.call(fig.querySelectorAll("[data-stage]"));
    var fires = Array.prototype.slice.call(fig.querySelectorAll(".pw-fire"));
    var NS = "http://www.w3.org/2000/svg";
    var reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    function el(parent, name, attrs, text) {
      var e = document.createElementNS(NS, name);
      for (var k in attrs) e.setAttribute(k, attrs[k]);
      if (text != null) e.textContent = text;
      parent.appendChild(e);
      return e;
    }
    function pathD(pts) {
      return pts.map(function (p, i) { return (i ? "L" : "M") + p[0] + " " + p[1]; }).join(" ");
    }

    // Traced from the diagram (image pixels). Tracts run from the motor cortex to a motor neuron in the spinal cord;
    // nerves run from that motor neuron to the hand. Keys: L/R = hemisphere or side, c = crossed, i = uncrossed.
    var PATHS = {
      A: {
        tracts: { Li: [[298,310],[297.5,322.5],[297.1,333.6],[297.6,348.2],[298.5,360.7],[298.4,374],[297,383.1],[294.7,397.8],[293.7,408],[292.5,418.7],[291.6,433.2],[290.8,443],[289.8,456.6],[289,469.3],[288,484],[286.7,494],[285,505.1],[283.6,518.9],[283,528.7],[281.3,542.3],[280,554.6],[278.7,570.3],[277,581],[275.7,591.7],[274,606.7],[272.3,617.4],[271,631],[268.3,643.8],[267.3,658.1],[268,669],[268,681.7],[269,694],[270.7,706],[270.2,716.2],[274.3,729.7],[286.8,736.6],[295.3,740.3],[306.8,746.5],[318,752]], Lc: [[312,315],[310.8,327.5],[308,342.2],[306.2,352.3],[305,362.8],[304.4,377.7],[305.3,390],[306.2,403.4],[307.2,413.4],[308.2,427],[309.3,438.8],[311.8,454.4],[312.8,464.2],[315.8,475.1],[319.6,489.6],[323.9,501.5],[328.6,514.9],[332.8,523.9],[340.9,535.5],[346.7,545],[354.2,552],[367.8,563],[376.3,569.6],[388.6,577.2],[399.3,582.9],[412.2,589.5],[421,594.5],[432.9,602.4],[442.8,610.5],[451.7,623],[458,633.3],[465.4,646.2],[466.2,657.8],[465.5,670.7],[466.3,682],[466.3,694.7],[465.3,708],[465.8,720.2],[462,734],[448,739.9],[438.2,742.3],[423.8,746],[418,748]], Rc: [[415,315],[417.8,327.5],[421.9,342.6],[424,352.1],[426.5,362.5],[429.5,377.7],[432.2,389.1],[433.4,402.9],[435.6,414.3],[437.4,427.9],[436.4,439.9],[434.3,450.4],[430.8,465.2],[428.2,476.6],[423.6,491.6],[418.2,501],[410.7,515.5],[405.1,524.7],[395.5,538.6],[387.6,545.8],[379.9,552.4],[367.8,562.7],[358.1,568.6],[345.6,575.7],[335.5,581.5],[326.8,588],[313.9,595.2],[304.6,600.6],[293.4,608.3],[285.4,615.9],[275.7,628],[271.7,638.8],[267.3,651.7],[268.3,663.9],[268.7,676],[268.2,688.2],[269.2,701.3],[269.6,714.8],[271.3,728.5],[279.1,735.7],[291.3,739.7],[300.5,743],[312.5,750],[318,752]], Ri: [[425,310],[426.9,322.5],[425.6,334],[428.3,349.1],[430,360.7],[432.7,374.5],[434.2,384.1],[436.7,397.5],[439.3,410],[441.8,423],[442.8,435.9],[442.3,446.4],[446.1,461],[447.7,471.7],[449.8,486.7],[451.1,498],[453,512.1],[454,521.7],[455.5,535.3],[456.8,547.3],[458,561.6],[459.2,572],[460.2,582],[461.2,597.4],[462.7,608.8],[463.7,622.9],[464.3,632.6],[466.2,646],[467.3,657.5],[466.5,669.5],[466.8,682],[466.3,694.7],[465.3,708],[465.8,720.2],[462,734],[448,739.9],[438.2,742.3],[423.8,746],[418,748]] },
        nerves: { L: [[318,752],[307,759.8],[296.2,767.5],[284.2,774],[271.2,779],[258.2,783.3],[245.2,787.2],[231.7,786],[220,781],[209.8,772.6],[200.4,763.5],[190.7,755.3],[181.8,748.2],[173.2,740.8],[163.1,731.8],[153.4,723.2],[144.2,713.5],[135.9,703.4],[128.5,692.2],[123.8,680.6],[121,671.4],[117.3,658.9],[114,646.5],[112,633.5],[112,620.9],[112,610],[112,599.1],[112.9,586.5],[113.8,580]], R: [[418,748],[429,757.7],[439.3,765.8],[449.1,772.7],[461.4,777.6],[474.3,781.3],[487.5,784.8],[500.6,786.1],[510.9,779.4],[519.5,773.8],[528,765],[538,756.4],[547.1,748.3],[554.4,742],[563.5,733.2],[572.2,723.6],[580.4,714.1],[586.6,705.8],[593.4,696.4],[600.2,686.3],[606.5,674.1],[611,662.5],[614.8,649.1],[616.9,636.6],[617.9,623.7],[618,610.8],[617.2,597.8],[615.5,585.1],[614.7,580]] },
      },
      B: {
        tracts: { Lc: [[1132,305],[1132.7,317.2],[1133.4,329.5],[1134,342],[1134.7,354],[1136,366],[1138,378],[1140,390],[1142,402],[1144,414],[1146.1,426],[1148.9,439.4],[1151.2,451.2],[1154,464.1],[1156.6,475.2],[1160.5,487.9],[1165.3,502.2],[1170.5,515.4],[1176.4,527.5],[1182.9,538.2],[1191,549.2],[1199.6,557.7],[1210.3,563.4],[1219.1,573.2],[1229.7,579.3],[1240.9,584.9],[1251.8,590.3],[1261.7,596.2],[1271.3,603.1],[1281,611.2],[1289,620.7],[1293.7,633.3],[1299,645.8],[1302.2,659.1],[1301.2,672.2],[1301.7,684],[1302.3,696.7],[1303.3,710],[1304.3,723.3],[1299,732.2],[1287,736.9],[1274.7,740.9],[1262,744.2],[1250,748]], Rc: [[1290,310],[1289.2,322.3],[1288.4,334.7],[1287.7,347],[1287,359],[1286.2,371.7],[1285,384],[1283.8,396],[1282,408],[1280,420],[1278,432],[1276,443.8],[1273.3,455.8],[1270.4,467.8],[1267.2,479.8],[1262.8,491.2],[1256.7,502.2],[1250,513.3],[1243.3,524.3],[1235.2,533.5],[1226.8,541.8],[1217.9,550.2],[1207,557],[1194.9,559.6],[1185.7,568.4],[1174.5,575.4],[1163.5,580.2],[1153.2,585],[1141.9,591.7],[1132.7,598.2],[1123.3,606.7],[1114.3,615.7],[1108,626.7],[1104,639.8],[1100,653],[1099,666],[1100.3,678],[1101.5,690.2],[1100.7,703.3],[1099.9,716.7],[1101.5,726.5],[1109.9,733.5],[1121,738],[1132.2,741.1],[1144.2,745.5],[1155,750]] },
        nerves: { L: [[1155,750],[1143.8,755.5],[1132.5,761.7],[1121.9,767],[1110.2,772.6],[1099.1,777],[1086.8,780.8],[1073.4,783.3],[1059.1,781.4],[1046.4,773.9],[1036.9,764.4],[1027,756.1],[1017.8,747.8],[1008.8,738.8],[1000.3,729.8],[992.4,720.1],[984.1,710.5],[976,700.2],[969.8,690.8],[962.8,678.6],[957.7,666.4],[954.1,653.5],[951.8,640.9],[950,625.5],[950.2,611.4],[950.9,599.8],[950.7,586.7],[950,580]], R: [[1250,748],[1261.2,754],[1272.2,760],[1283.3,766],[1294.3,772],[1306,776],[1318.3,778.9],[1331,781.5],[1343.8,781.5],[1354,776.8],[1362.4,766.9],[1371.3,758.1],[1381,749.3],[1390,740],[1398.2,730.2],[1407.6,721.1],[1416.7,711.6],[1425.2,701.8],[1432.6,691.6],[1438.5,681.4],[1444,669.9],[1448.2,658.1],[1451.3,646.2],[1453.4,633.1],[1454.7,620],[1454.5,607.2],[1452.9,594.3],[1452,581.3],[1452,575]] },
      },
      C: {
        tracts: { Rc: [[2090,312],[2089.3,324.4],[2088.7,336.9],[2087.8,349],[2087,361.3],[2086.3,374],[2085,386],[2083.7,398],[2082,410],[2080.3,422],[2079,433.8],[2076.1,445.3],[2073.1,458.5],[2070.1,470.8],[2066.1,483.1],[2061.8,494.3],[2055.3,505],[2048.3,515],[2040.2,524.2],[2031.8,533.6],[2022.7,542.5],[2011.6,551.1],[2001.2,557.8],[1990.2,563.7],[1978.3,569.5],[1966.6,574.5],[1955.5,579.9],[1944.2,586.2],[1933,593.7],[1923.6,602.2],[1915.3,613],[1908.7,625.3],[1904.4,639],[1901.7,653],[1902.8,667],[1904,681],[1905,694.3],[1905,707.2],[1906.5,719.2],[1917,726],[1928.7,732.3],[1940,738.1],[1952,745],[1958,748]], Ri: [[2045,290],[2047.5,302.5],[2050,315],[2052.5,327.5],[2056.3,339.9],[2059.3,352],[2062,366.1],[2063.6,375],[2066.1,388.7],[2067.7,401.6],[2070.5,415.9],[2071.6,427.3],[2075.2,442.6],[2075.8,453.5],[2076.4,462.4],[2078.8,478.7],[2080.3,489.6],[2082,503.9],[2083.4,515.5],[2085.6,530],[2086.4,538.9],[2088.1,552.7],[2089.7,564.3],[2091.2,573.2],[2093,588.8],[2094.5,599.7],[2096.9,614.7],[2098.9,626.7],[2100.9,640.6],[2102.5,650],[2105.2,663.7],[2106.2,674.9],[2105,694.2],[2105,709.4],[2103.3,721],[2096.4,728.4],[2083.5,733.6],[2072,738.4],[2055.1,746.3],[2053.8,746.6]] },
        nerves: { L: [[1958,748],[1947.2,754.8],[1936,761.7],[1924.6,767.8],[1914,772.1],[1902,775],[1890,777],[1878,779],[1866,780.8],[1855.7,778.1],[1847.9,769.5],[1838.7,759.6],[1828.8,751.2],[1818.9,743.1],[1809,734.3],[1800.3,725],[1793,714.5],[1784.9,704.6],[1777.1,694.5],[1769.7,683.3],[1763.6,672.1],[1758.7,660.7],[1755.6,649.3],[1752.9,635.9],[1751.7,623.2],[1751.5,610.5],[1752,597.8],[1751.2,586],[1751.5,573.8],[1751.6,571.3]], R: [[2053.8,746.6],[2061.5,753.2],[2072.5,761.4],[2080.7,765.8],[2092.3,771.1],[2104.8,775.6],[2118.5,778.5],[2131.2,778.8],[2143.5,775.3],[2154.3,765.9],[2163.7,758.8],[2174.3,751.2],[2184.4,743.2],[2190.7,735.5],[2199.8,726.1],[2208.7,717],[2217.8,707.7],[2226.6,697.7],[2232.7,684.9],[2233.5,669.8],[2238.3,664.5],[2250.8,652.1],[2252.4,638.6],[2248.6,626.8],[2254.1,613.6],[2256.5,601.5],[2257.7,596.8]] },
      },
    };
    var PANEL_X = { A: 0, B: 800, C: 1600 };
    var TRACT_SIDE = { Lc: ["L", "R"], Li: ["L", "L"], Rc: ["R", "L"], Ri: ["R", "R"] }; // [from hemisphere, to hand]
    var TYPE = { A: "immature", B: "mature", C: "mature" };
    // Positions per panel, in image pixels.
    var COIL = { A: { L: [300, 118], R: [420, 118] }, B: { L: [1140, 112], R: [1262, 112] }, C: { L: [1940, 110], R: [2062, 110] } };
    var ORIGIN = { A: { L: [305, 312], R: [420, 312] }, B: { L: [1132, 305], R: [1290, 310] }, C: { L: [1930, 292], R: [2088, 315] } };
    var HANDC = { A: { L: [100, 645], R: [632, 655] }, B: { L: [935, 645], R: [1468, 655] }, C: { L: [1735, 645], R: [2268, 655] } };
    var MEPPOS = { A: { L: [28, 792], R: [640, 796] }, B: { L: [862, 792], R: [1478, 796] }, C: { L: [1660, 792], R: [2290, 796] } };

    var TEXT = {
      A: "Immature: early in development, each hemisphere sends motor tracts to both sides of the spinal cord, so each hand is connected to both hemispheres.",
      B: "Typical development: the ipsilateral tracts are pruned away and the contralateral ones mature, so each hemisphere controls the opposite hand.",
      C: "Prenatal injury (unilateral CP): the lesioned hemisphere loses its tract, and the non-lesioned hemisphere keeps an atypical ipsilateral tract to the affected hand, alongside its normal contralateral one.",
    };
    var TMS_TEXT = {
      A: { L: "TMS over the left hemisphere: both hands respond, through contralateral and ipsilateral tracts.",
           R: "TMS over the right hemisphere: both hands respond, through contralateral and ipsilateral tracts." },
      B: { L: "TMS over the left hemisphere: only the right hand responds (contralateral).",
           R: "TMS over the right hemisphere: only the left hand responds (contralateral)." },
      C: { L: "TMS over the lesioned left hemisphere: no response in this example, because its motor tract was lost.",
           R: "TMS over the non-lesioned right hemisphere: both hands respond. The response in the affected right hand travels through an ipsilateral tract, and detecting it is one thing TMS is used for." },
    };

    // Invisible guide paths for every tract and nerve, plus a layer for effects.
    var guides = {};
    Object.keys(PATHS).forEach(function (st) {
      guides[st] = { tracts: {}, nerves: {} };
      Object.keys(PATHS[st].tracts).forEach(function (k) {
        guides[st].tracts[k] = el(svg, "path", { d: pathD(PATHS[st].tracts[k]), class: "pw-guide" });
      });
      Object.keys(PATHS[st].nerves).forEach(function (k) {
        guides[st].nerves[k] = el(svg, "path", { d: pathD(PATHS[st].nerves[k]), class: "pw-guide" });
      });
    });
    var fx = el(svg, "g", { class: "pw-fx" });

    // ---------- Panning between panels ----------
    var stage = "A", viewX = 0, panRaf = null;
    function setView(x) {
      viewX = x;
      svg.setAttribute("viewBox", x + " 0 800 830");
    }
    function panTo(x) {
      if (panRaf) cancelAnimationFrame(panRaf);
      if (reduce) return setView(x);
      var from = viewX, t0 = null;
      function f(now) {
        if (t0 === null) t0 = now;
        var p = Math.min(1, (now - t0) / 650), e = p < 0.5 ? 2 * p * p : 1 - Math.pow(-2 * p + 2, 2) / 2;
        setView(from + (x - from) * e);
        panRaf = p < 1 ? requestAnimationFrame(f) : null;
      }
      panRaf = requestAnimationFrame(f);
    }
    function clearFx() { while (fx.firstChild) fx.removeChild(fx.firstChild); }
    function setStage(s) {
      stage = s;
      clearFx();
      panTo(PANEL_X[s]);
      tabs.forEach(function (t) {
        var on = t.dataset.stage === s;
        t.classList.toggle("is-current", on);
        t.setAttribute("aria-selected", on ? "true" : "false");
      });
      desc.textContent = TEXT[s];
      result.textContent = "Press a TMS button to see which hands respond.";
    }

    // ---------- TMS pulse ----------
    var busy = false;
    function travel(path, dur, cls, done) {
      if (reduce) return done();
      var len = path.getTotalLength(), dot = el(fx, "circle", { r: 10, class: "pw-pulse " + cls }), t0 = null;
      function f(now) {
        if (t0 === null) t0 = now;
        var p = Math.min(1, (now - t0) / dur), pt = path.getPointAtLength(p * len);
        dot.setAttribute("cx", pt.x);
        dot.setAttribute("cy", pt.y);
        if (p < 1) requestAnimationFrame(f);
        else { if (dot.parentNode) fx.removeChild(dot); done(); }
      }
      requestAnimationFrame(f);
    }
    function respond(side) {
      var c = HANDC[stage][side], m = MEPPOS[stage][side];
      el(fx, "circle", { cx: c[0], cy: c[1], r: 100, class: "pw-hand-ring" + (reduce ? "" : " is-pulsing") });
      var g = el(fx, "g", { class: "pw-mep" });
      el(g, "polyline", {
        points: [[0, 0], [20, 0], [27, 18], [36, -20], [44, 0], [84, 0]] // biphasic MEP: negative deflection first
          .map(function (p) { return m[0] + p[0] + "," + (m[1] + p[1]); }).join(" "),
        class: "pw-mep-line",
      });
      el(g, "text", { x: m[0] + 42, y: m[1] - 26, class: "pw-mep-text", "text-anchor": "middle" }, "MEP");
    }
    function fire(side) {
      if (busy) return;
      busy = true;
      clearFx();
      result.textContent = "";
      var co = COIL[stage][side], o = ORIGIN[stage][side];
      var coil = el(fx, "g", { class: "pw-coil" });
      el(coil, "circle", { cx: co[0] - 22, cy: co[1], r: 22 });
      el(coil, "circle", { cx: co[0] + 22, cy: co[1], r: 22 });
      el(fx, "circle", { cx: o[0], cy: o[1], r: 12, class: "pw-flash" });
      var live = Object.keys(PATHS[stage].tracts).filter(function (k) { return TRACT_SIDE[k][0] === side; });
      var pending = live.length;
      function finish() {
        setTimeout(function () {
          if (coil.parentNode) fx.removeChild(coil);
          result.textContent = TMS_TEXT[stage][side];
          busy = false;
        }, reduce ? 0 : 250);
      }
      if (!pending) return finish();
      live.forEach(function (k) {
        var to = TRACT_SIDE[k][1];
        var atypical = stage === "C" && k === "Ri";
        var speed = TYPE[stage] === "immature" ? 1.5 : 1;
        travel(guides[stage].tracts[k], 950 * speed, atypical ? "is-atypical" : "", function () {
          travel(guides[stage].nerves[to], 650 * speed, atypical ? "is-atypical" : "", function () {
            respond(to);
            if (--pending === 0) finish();
          });
        });
      });
    }

    tabs.forEach(function (t) { t.addEventListener("click", function () { if (!busy) setStage(t.dataset.stage); }); });
    fires.forEach(function (b) { b.addEventListener("click", function () { fire(b.dataset.side); }); });
    setView(0);
    setStage("A");
  })();
</script>
