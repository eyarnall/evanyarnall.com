{%- comment -%}
  One reference on the CV (used by _includes/cv_body.liquid through jekyll-scholar's --template option).
  Authors print as "Last FI", Evan underlined; long conference names are shortened (the CV defines the abbreviations).
{%- endcomment -%}
{%- capture authors -%}
  {%- for a in entry.author_array -%}
    {%- assign initials = '' -%}
    {%- assign parts = a.first | replace: '.', ' ' | split: ' ' -%}
    {%- for part in parts -%}{%- assign ch = part | slice: 0 -%}{%- assign initials = initials | append: ch -%}{%- endfor -%}
    {%- if a.last contains 'Yarnall' -%}<span class="me">{{ a.last }} {{ initials }}</span>{%- else -%}{{ a.last }} {{ initials }}{%- endif -%}
    {%- unless forloop.last -%}, {% endunless -%}
  {%- endfor -%}
{%- endcapture -%}
{%- assign yearnum = entry.year | plus: 0 -%}
{%- assign venue = entry.booktitle
  | replace: 'American Academy for Cerebral Palsy and Developmental Medicine (AACPDM)', 'AACPDM'
  | replace: 'American Society of Neurorehabilitation (ASNR)', 'ASNR'
-%}
{%- assign title = entry.title | remove: '{' | remove: '}' -%}
<span class="cv-ref">
  {%- if entry.type == 'article' -%}
    {{ authors }}. ({{ entry.year }}). {{ title }}. <i>{{ entry.journal }}</i>
    {%- if entry.volume -%}, {{ entry.volume }}{%- if entry.number -%}({{ entry.number }}){%- endif -%}{%- endif -%}
    {%- if entry.pages -%}, {{ entry.pages }}{%- endif -%}.
    {%- if entry.doi %} doi:{{ entry.doi }}{%- endif -%}
  {%- elsif entry.type == 'unpublished' -%}
    {{ authors }}. {{ title }}.
    {%- if entry.status == 'review' %} <i>{{ entry.note | remove: 'Under review, ' }}</i>.{%- endif -%}
  {%- else -%}
    {{ authors }}.{% if yearnum > 0 %} ({{ entry.year }}).{% endif %} {{ title }}. <i>{{ venue }}</i>
    {%- if entry.address -%}, {{ entry.address }}{%- endif -%}.
    {%- if entry.note %} <span class="cv-tag">{{ entry.note }}</span>{%- endif -%}
  {%- endif -%}
</span>
