@inproceedings{yarnall2026bilateral,
  abbr        = {AACPDM},
  bibtex_show = {true},
  title       = {Longitudinal Trajectories of Bilateral Hand Use: Changes in Behavior and Cortical Activity},
  author      = {Yarnall, Evan and Kelly, M. and Kim, H. and Su, X. and Ferre, C. L.},
  summary     = {Between 6 and 24 months, babies spent about the same share of playtime touching toys, but more of that touching used both hands, often with each hand doing a different job. Brain activity shifted to match, from both sides of the brain toward the side opposite the active hand.},
  booktitle   = {American Academy for Cerebral Palsy and Developmental Medicine (AACPDM) 80th Annual Meeting},
  address     = {Philadelphia, PA},
  year        = {2026},
  month       = {Sep},
  note        = {Scientific poster SP20},
  abstract    = {Infants' manual interactions undergo drastic shifts during the first two years of life. Specifically, there are changes in bimanual object manipulation where young infants use both hands together for the same purpose and older infants start coordinating hands to different but complementary tasks. This advanced skill is known as role-differentiated bimanual manipulation (RDBM). Understanding the developmental trajectories of these bimanual skills and the corresponding changes in brain development could provide potential intervention targets for improving these skills in children at risk of cerebral palsy (CP). The aim of this study is to evaluate the bimanual behavior patterns in relation to cortical activity in typically developing (TD) infants. We hope to provide a paradigm and baseline for comparison with infants at risk of CP. Experimental tasks were conducted with a cohort of 20 TD infants in a child-friendly laboratory environment. We used a longitudinal prospective design. Children were presented with toys during semi-structured play sessions every 3 months from 6 to 24 months. Each session was recorded with two cameras and bouts of contact with the toy and type of contact were coded using Datavyu. Video recordings were synched with functional near-infrared spectroscopy (fNIRS) acquisition. Cortical activity was measured using an fNIRS probe located over sensorimotor areas. A linear mixed effects model was used to evaluate the relationship between age and percentage of the session in contact with the toy, the percentage of contact that was bimanual, and the percentage of bimanual contact that was role-differentiated. A total of 46 sessions were completed. Percentage in contact with toys was stable: 70.6\% (SD=15.3) at 6 months and 68.4\% (SD=16.7) at 24 months; age accounted for 1.5\% of variance. In contrast, percentage of bilateral contact increased from 49.9\% (SD=13) to 67.2\% (SD=7.6), showing 0.89\%/month increase (95\% CI:[0.24,1.4], p=0.009; marginal R²=10.3\%, conditional R²=58.1\%). RDBM as percentage of bilateral contact increased from 24.5\% (SD=11.8) to 34.7\% (SD=13.4), showing 1.21\%/month increase (95\% CI:[0.53,1.89], p=0.001; marginal R²=21.2\%, conditional R²=31.5\%). Cortical activation shifted from bilateral to contralateral patterns during RDBM. The percentage of the session in contact with the toy remained relatively stable across ages however the ways in which the infants engaged with toys changed. Infants showed increased bilateral contact and greater role-differentiated bimanual manipulation with age. Cortical activity reflected this upshift in asymmetric bimanual activity with a shift from bilateral activation to more activation contralateral to the active hand. These findings provide insights into how developmental changes allow infants to access new affordances of toys and are reflected in cortical activation in TD infants. Future work will characterize these developmental patterns in infants at risk for CP.},
  poster      = {Yarnall_AACPDM2026_SP20_poster.pdf},
  preview     = {yarnall2026bilateral.jpg},
  selected    = {true}
}

@inproceedings{yarnall2026board,
  abbr        = {AACPDM},
  bibtex_show = {true},
  title       = {Moving Target Board for Testing Online Motor Control},
  author      = {Yarnall, Evan and Zayas, J. and Ferre, C. L.},
  summary     = {A new device for testing how children correct a reach mid-movement: a real target on a motorized track jumps sideways as the child reaches for it, while a soft cap measures brain activity with light (fNIRS). It was built to understand how children control their reaches, including kids with cerebral palsy that affects one side of their body.},
  booktitle   = {American Academy for Cerebral Palsy and Developmental Medicine (AACPDM) 80th Annual Meeting},
  address     = {Philadelphia, PA},
  year        = {2026},
  month       = {Sep},
  note        = {Demonstration poster DP26},
  abstract    = {Children with unilateral cerebral palsy (UCP) demonstrate impairments in online motor control, particularly difficulty adjusting reach trajectories in response to target perturbations. Current assessments predominantly use screen-based virtual targets, which may not fully replicate the sensorimotor demands of physical reaching, limiting ecological validity and generalizability to functional activities. Our objective is to demonstrate a novel physical moving target apparatus designed to assess online motor control in children with UCP, integrating real-time target perturbation with concurrent functional near-infrared spectroscopy (fNIRS) to examine cortical activity. The apparatus consists of a horizontal target board (approximately 60 cm wide) with a linear track and enclosed motorized target system. Children and adolescents (ages 6-17 years) are seated with target distance individually normalized to 70-80\% of comfortable reach based on arm length. Participants initiate a reach from a home button toward an illuminated target. When the hand reaches 35\% of the distance to target (approximately peak reach velocity), a camera-based position-tracking system triggers the target to shift laterally by ±10 cm at 24 cm/s, requiring rapid online trajectory adjustment. This paradigm challenges core components of online sensorimotor integration: visual monitoring, proprioceptive updating, and motor planning. Participants complete reaches with both affected and unaffected limbs under static and dynamic target conditions. Concurrent fNIRS captures cortical activation patterns to examine neural correlates of online motor control. The system features child-safe design with enclosed moving components and age-appropriate reach distances. Physical reaching tasks engage haptic and proprioceptive cues not captured by screen-based paradigms, enhancing ecological validity. Findings may better predict functional outcomes in daily activities such as grasping toys or catching objects which are skills essential for children with CP in activities of daily living and play. This strengthens lab-to-clinic translation. Integrating physical reaching with neuroimaging enables examination of cortical activation during realistic sensorimotor challenges. This may reveal neural signatures distinguishing successful from unsuccessful trajectory adjustments and identify mechanisms underlying motor control deficits in CP. Clinically, the apparatus may inform intervention planning by identifying which components of online motor control—visual feedback processing, trajectory planning, or motor execution—are most impaired. To our knowledge, this is the first physical moving target apparatus developed to assess online motor control in children with CP using concurrent neuroimaging. Future research will establish test-retest reliability, examine predictive validity for functional outcomes, and explore whether training yields intervention benefits.},
  poster      = {Yarnall_AACPDM2026_DP26_poster.pdf},
  video       = {https://youtube.com/shorts/V6jFa3vHAho},
  preview     = {yarnall2026board.jpg},
  selected    = {true}
}

